# Copy to .env — never commit the filled-in file.
# Any key from config/settings.yaml can be overridden here.

# SOLARCAST_CONFIG=config/settings.yaml
# SOLARCAST_DATABASE__URL=postgresql+asyncpg://solarcast:password@localhost:5432/solarcast
# SOLARCAST_LOGGING__LEVEL=DEBUG
# SOLARCAST_LOGGING__JSON_FORMAT=true
